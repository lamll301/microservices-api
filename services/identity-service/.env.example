# ===== PostgreSQL =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=identity_db
DB_USER=postgres
DB_PASSWORD=change_me

# ===== JWT =====
# Tối thiểu 32 ký tự. Tạo nhanh: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=identity-service
JWT_AUDIENCE=microservices-api
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# ===== Seed dữ liệu ban đầu (role Admin/User + tài khoản admin) =====
# Mật khẩu phải thỏa quy tắc: >= 8 ký tự, có chữ hoa, chữ thường và số
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
ADMIN_FULLNAME=Administrator
SEED_DATA=true

# ===== Dọn refresh token hết hạn =====
TOKEN_CLEANUP_ENABLED=true
TOKEN_CLEANUP_INTERVAL_HOURS=6
# Token hết hạn bao nhiêu ngày thì mới bị xóa hẳn khỏi DB
TOKEN_CLEANUP_RETENTION_DAYS=7

# ===== Email (SMTP) =====
# Dev: dùng Mailpit trong docker-compose (không cần user/password), xem email tại http://localhost:8025
# Khi chạy bằng docker compose thì SMTP_HOST/SMTP_PORT được đặt cố định trong docker-compose.yml
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@identity-service.local
SMTP_FROM_NAME=Identity Service
# Ví dụ SMTP thật (Gmail): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=ban@gmail.com, SMTP_PASSWORD=<app password>

# ===== Xác thực email / đặt lại mật khẩu =====
# URL public của API (link xác thực email trỏ vào đây)
API_PUBLIC_URL=http://localhost:5137
# URL frontend (link đặt lại mật khẩu trỏ tới trang /reset-password của frontend)
FRONTEND_URL=http://localhost:3000
# true: phải xác thực email mới được đăng nhập
REQUIRE_CONFIRMED_EMAIL=true
# Thời gian sống của link xác thực / đặt lại mật khẩu (giờ)
EMAIL_TOKEN_LIFESPAN_HOURS=2
# Số request tối đa / 15 phút / IP cho các endpoint gửi email (register, forgot-password, resend-confirmation)
EMAIL_RATE_LIMIT_PERMITS=10

# ===== App =====
ASPNETCORE_ENVIRONMENT=Development
AUTO_MIGRATE=true
