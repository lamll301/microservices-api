# ===== PostgreSQL =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=identity_db
DB_USER=postgres
DB_PASSWORD=change_me

# ===== JWT =====
# Tối thiểu 32 ký tự. Tạo nhanh: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=identity-service
JWT_AUDIENCE=microservices-api
JWT_EXPIRE_MINUTES=60

# ===== App =====
ASPNETCORE_ENVIRONMENT=Development
AUTO_MIGRATE=true
